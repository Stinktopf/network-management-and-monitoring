    {
      "id": 2,
      "type": "stat",
      "title": "Probe exporters / 2 expected",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"reefnet-service-probes\"})"
