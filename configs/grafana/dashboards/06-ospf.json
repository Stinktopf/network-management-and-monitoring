    {
      "id": 1,
      "type": "table",
      "title": "OSPF neighbors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "description": "Current adjacency state by router, instance and core interface. In ReefNet, default is OSPFv2 and ipv6 is OSPFv3.",
      "targets": [
        {
          "refId": "A",
          "expr": "reefnet_ospf_neighbor_state{source=~\"$device\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "source",
                "instance_name",
                "area_area_id",
                "interface_interface_name",
                "neighbor_router_id",
                "adjacency_state"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "source": 0,
              "instance_name": 1,
              "area_area_id": 2,
              "interface_interface_name": 3,
              "neighbor_router_id": 4,
              "adjacency_state": 5
            },
            "renameByName": {
              "source": "Device",
              "instance_name": "Instance",
              "area_area_id": "Area",
              "interface_interface_name": "Interface",
              "neighbor_router_id": "Neighbor router ID",
              "adjacency_state": "State"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "srl_nokia-ospf-types:full": {
                        "text": "Full",
                        "color": "green"
                      },
                      "srl_nokia-ospf-types:down": {
                        "text": "Down",
                        "color": "red"
                      },
                      "srl_nokia-ospf-types:attempt": {
                        "text": "Attempt",
                        "color": "orange"
                      },
                      "srl_nokia-ospf-types:init": {
                        "text": "Init",
                        "color": "orange"
                      },
                      "srl_nokia-ospf-types:two-way": {
                        "text": "Two-Way",
                        "color": "orange"
                      },
                      "srl_nokia-ospf-types:exstart": {
                        "text": "Exstart",
                        "color": "orange"
                      },
                      "srl_nokia-ospf-types:exchange": {
                        "text": "Exchange",
                        "color": "orange"
                      },
                      "srl_nokia-ospf-types:loading": {
                        "text": "Loading",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Instance"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "default": {
                        "text": "OSPFv2"
                      },
                      "ipv6": {
                        "text": "OSPFv3"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "OSPFv2 / full adjacencies",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (source, interface_interface_name) (reefnet_ospf_full_neighbors{source=~\"$device\",instance_name=\"default\",interface_interface_name=~\"ethernet.*\"})",
