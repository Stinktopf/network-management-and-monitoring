      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "red"
                },
                "1": {
                  "text": "Enabled",
                  "color": "green"
                }
              }
