    {
      "id": 100,
      "type": "stat",
      "title": "Capacity per direction",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(reefnet_link_capacity_bps{link_id=~\"$link\"})) or (0 * max(reefnet_link_oper_up{link_id=~\"core-a|core-b\",link_id=~\"$link\"}) - 2)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "noValue": "Unknown",
          "color": {
            "mode": "fixed",
            "fixedColor": "#56B8C9"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#F2495C",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "Uncapped",
                  "color": "#a3a7af"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "valueSize": 36
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
