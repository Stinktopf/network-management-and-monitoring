    {
      "id": 7,
      "type": "logs",
      "title": "SR Linux events · correlate state changes",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"srlinux\",source=~\"$device\"} != \"Unable to retrieve TLS profile 'EDA'\" != \"No valid license\" != \"no default license file nor configured license instances\" != \"Memory utilization on ram module\" != \"CPU utilization on cpu module\" != \"LogSetConfigLevelsToWarning\" != \"HandleFibMgrNhResolve\"",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "description": "Curated SR Linux events for the selected device set. Raw Loki retains the simulator messages filtered here."
    }
