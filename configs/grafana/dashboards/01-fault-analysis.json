    {
      "id": 1,
      "type": "timeseries",
      "title": "Probe success · what is failing?",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(reefnet_probe_success{source=~\"$probe_source\",af=~\"$af\",probe=~\"$probe_type\"}[30s])",
          "legendFormat": "{{source}} · {{probe}} · {{af}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Use this to separate source path, address family and application-level impact."
    },
