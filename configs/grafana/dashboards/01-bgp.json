    {
      "id": 1,
      "type": "table",
      "title": "BGP sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "description": "Current session state per router and peer address. Peer transport family is not the advertised route family. Check Telemetry Health if data is missing.",
      "targets": [
        {
          "refId": "A",
          "expr": "reefnet_bgp_neighbor_session_state{source=~\"$device\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "source",
                "neighbor_peer_address",
                "session_state"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "source": 0,
              "neighbor_peer_address": 1,
              "session_state": 2
            },
            "renameByName": {
              "source": "Device",
              "neighbor_peer_address": "Peer",
              "session_state": "State"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "established": {
                        "text": "Established",
                        "color": "green"
                      },
                      "idle": {
                        "text": "Idle",
                        "color": "red"
                      },
                      "active": {
                        "text": "Active",
                        "color": "orange"
                      },
                      "connect": {
                        "text": "Connect",
                        "color": "orange"
                      },
                      "open-sent": {
                        "text": "Open sent",
                        "color": "orange"
                      },
                      "open-confirm": {
                        "text": "Open confirm",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
